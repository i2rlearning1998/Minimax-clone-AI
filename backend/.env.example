TTS_PROVIDER=mock
# API keys are loaded ONLY from backend/.env. Leave blank for mock.
REPLICATE_API_TOKEN=
FAL_KEY=
# Optional model overrides. Otherwise config/routing.json is used.
REPLICATE_MODEL=
FAL_MODEL=
PROVIDER_TIMEOUT_SEC=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional absolute paths; defaults are backend/outputs and its history.sqlite3.
# OUTPUT_DIR=
# DATABASE_PATH=
# ROUTING_PATH=
