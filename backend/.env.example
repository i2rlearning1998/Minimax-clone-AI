TTS_PROVIDER=mock
# Keys can come from the Settings UI, process environment or this file. Leave blank for mock.
REPLICATE_API_TOKEN=
FAL_KEY=
# Optional model overrides. Otherwise config/routing.json is used.
REPLICATE_MODEL=
FAL_MODEL=
PROVIDER_TIMEOUT_SEC=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# Optional absolute paths; defaults are backend/outputs and its history.sqlite3.
# OUTPUT_DIR=
# DATABASE_PATH=
# ROUTING_PATH=

# Optional Cloudflare free-tier credentials; Settings UI can save these too.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# TTS_PROVIDER may also be edge (no key), cloudflare, or free.
